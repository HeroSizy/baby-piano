{
  "$schema": "node_modules/wrangler/config-schema.json",
  // mashpiano.herosizy.dev: the static page in public/, and a few lines of
  // Worker (src/worker.js) that send /download/<platform> to that file of
  // the latest GitHub Release, so the page never needs a redeploy for a
  // new version. Cloudflare's Git integration (Workers Builds, root
  // directory site/) deploys it on every push to main that touches site/.
  "name": "mashpiano-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/download/*", "/api/*"]
  },
  "routes": [{ "pattern": "mashpiano.herosizy.dev", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true },
  // Cloudflare's Git builds run `wrangler versions upload` (a preview) for
  // branches other than main, which needs this block, even empty.
  "previews": {}
}
